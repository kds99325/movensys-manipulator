<?xml version="1.0" encoding="utf-8"?>
<robot name="movensys_manipulator">

  <!-- Arm group as chain -->
  <group name="movensys_manipulator_arm">
    <chain base_link="Link0" tip_link="Link6"/>
  </group>

  <!-- Group states for arm -->
  <group_state group="movensys_manipulator_arm" name="initial">
    <joint name="joint1" value="1.5699"/>
    <joint name="joint2" value="0.0928"/>
    <joint name="joint3" value="1.0152"/>
    <joint name="joint4" value="0.4683"/>
    <joint name="joint5" value="-1.57"/>
    <joint name="joint6" value="-0.0"/>
  </group_state>
  <group_state group="movensys_manipulator_arm" name="zero">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>
  <group_state group="movensys_manipulator_arm" name="test">
    <joint name="joint1" value="0.7294"/>
    <joint name="joint2" value="0.2207"/>
    <joint name="joint3" value="0.8773"/>
    <joint name="joint4" value="0.4882"/>
    <joint name="joint5" value="-1.5784"/>
    <joint name="joint6" value="-0.8404"/>
  </group_state>

  <group name="movensys_manipulator_eef">
    <link name="gripper"/>
  </group>
  
  <!-- End-Effector -->
  <end_effector group="movensys_manipulator_eef" name="movensys_manipulator_eef" parent_group="movensys_manipulator_arm" parent_link="Link6"/>

  <!-- Disable collisions between adjacent and irrelevant links -->
  <disable_collisions link1="table" link2="Link0" reason="Adjacent"/>
  <disable_collisions link1="table" link2="Link1" reason="Never"/>
  <disable_collisions link1="table" link2="Link2" reason="Never"/>
  <disable_collisions link1="table" link2="Link3" reason="Never"/>
  <disable_collisions link1="table" link2="Link4" reason="Never"/>
  <disable_collisions link1="table" link2="Link5" reason="Never"/>
  <disable_collisions link1="table" link2="Link6" reason="Never"/>
  <disable_collisions link1="table" link2="gripper" reason="Never"/>
  <disable_collisions link1="table" link2="picker_1" reason="Never"/>
  <disable_collisions link1="table" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link0" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="Link0" link2="Link2" reason="Never"/>
  <disable_collisions link1="Link0" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link0" link2="Link4" reason="Never"/>
  <disable_collisions link1="Link0" link2="Link5" reason="Never"/>
  <disable_collisions link1="Link0" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link0" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link0" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link0" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link4" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link5" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link1" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link1" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link1" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
  <disable_collisions link1="Link2" link2="Link4" reason="Never"/>
  <disable_collisions link1="Link2" link2="Link5" reason="Never"/>
  <disable_collisions link1="Link2" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link2" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link2" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link2" link2="picker_2" reason="Never"/>
  
  <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="Link5" reason="Never"/>
  <disable_collisions link1="Link3" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link3" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link3" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link3" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link4" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link4" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link4" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
  <disable_collisions link1="Link5" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link5" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link5" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link6" link2="gripper" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link6" link2="picker_2" reason="Never"/>

  <disable_collisions link1="gripper" link2="picker_1" reason="Adjacent"/>
  <disable_collisions link1="gripper" link2="picker_2" reason="Adjacent"/>

  <disable_collisions link1="picker_1" link2="picker_2" reason="Adjacent"/>
</robot>
