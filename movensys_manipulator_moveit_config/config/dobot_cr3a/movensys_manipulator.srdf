  <disable_collisions link1="Link5" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link5" link2="picker_2" reason="Never"/>

  <disable_collisions link1="Link6" link2="bracket" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="gripper" reason="Never"/>
  <disable_collisions link1="Link6" link2="picker_1" reason="Never"/>
  <disable_collisions link1="Link6" link2="picker_2" reason="Never"/>

  <disable_collisions link1="bracket" link2="gripper" reason="Adjacent"/>
  <disable_collisions link1="bracket" link2="picker_1" reason="Never"/>
  <disable_collisions link1="bracket" link2="picker_2" reason="Never"/>

  <disable_collisions link1="gripper" link2="picker_1" reason="Adjacent"/>
